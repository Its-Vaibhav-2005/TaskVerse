{
  "name": "trackverse",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "description": "A private, productive habit tracker with native SQLite storage.",
  "author": "TrackVerse",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test:desktop": "node --test desktop/*.test.cjs",
    "dist:win": "node tool/validate-signing.cjs && node tool/validate-release.cjs && electron-builder --config tool/windows-release.cjs --win msi --x64 --publish never",
    "test:release": "node --test tool/windows-release.test.cjs",
    "audit:release": "node tool/audit-release.cjs",
    "pack:win": "node tool/validate-signing.cjs && electron-builder --config tool/windows-release.cjs --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.trackverse.desktop",
    "productName": "TrackVerse",
    "asar": true,
    "forceCodeSigning": true,
    "extraResources": [
      {
        "from": ".config/google-client.json",
        "to": "google-client.json"
      },
      {
        "from": "LICENSE",
        "to": "TRACKVERSE-LICENSE.txt"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*.cjs",
      "desktop/pomodoro.html",
      "!desktop/**/*.test.cjs",
      "build/web/**/*",
      "assets/trackverse.ico",
      "assets/themes.json",
      "package.json",
      "!desktop/sample-tracker.cjs",
      "!desktop/fixtures/**"
    ],
    "win": {
      "target": "msi",
      "icon": "assets/trackverse.ico",
      "signExecutable": true,
      "signExts": [
        ".dll",
        ".node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TrackVerse-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "msi": {
      "upgradeCode": "F5E63BAD-FABA-5A01-85F8-71FEBD579F35",
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TrackVerse-Setup-${version}-x64.${ext}",
      "additionalLightArgs": [
        "-sval"
      ]
    },
    "msiProjectCreated": "tool/msi-project.cjs"
  },
  "dependencies": {
    "google-auth-library": "^11.3.1"
  }
}
